{
  "name": "jobsweep",
  "version": "0.0.1",
  "private": true,
  "description": "Local-first job hunting assistant",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "dev": "node scripts/ensure-electron.mjs && electron-vite dev",
    "build": "electron-vite build",
    "start": "node scripts/ensure-electron.mjs && electron-vite preview",
    "dist": "node scripts/ensure-electron.mjs && electron-vite build && electron-builder --win --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE=1 vitest run tests/db.test.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "framer-motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "docx": "^9.10.0",
    "imapflow": "^2.4.0",
    "jszip": "^3.10.2",
    "mailparser": "^3.9.38",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.0",
    "systeminformation": "^5.33.15",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.13"
  },
  "author": "Cyberhex1"
}
